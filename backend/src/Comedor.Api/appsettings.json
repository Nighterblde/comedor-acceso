  },
  "App": {
    "UrlPublica": "http://localhost:4200"
  },
  "Cors": {
    "Origenes": [ "http://localhost:4200" ]
  },
  "Fuente": {
    "RutaEmpleados": "datos/empleados-simulados.json"
