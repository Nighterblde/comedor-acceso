    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Comedor": {
    "ZonaHoraria": "America/Hermosillo"
  },
  "Qr": {
    "SegundosRotacion": 30,
    "SegundosValidez": 60
  },
  "Sesion": {
